APP_NAME=RackAtlas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=sk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

SESSION_LIFETIME=3600
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

#Redis
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=dev-
REDIS_PERSISTENT=true

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

#Cloudflare Turnstile (Invisible widget). Leave empty to turn the check off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FIREBASE_CREDENTIALS=
ANDROID_APP_SHA256=

#Terminal
TERMINAL_URL=wss://your-app/terminal-ws
TERMINAL_HOST=
TERMINAL_PORT=8787
TERMINAL_SECRET=

#Contact form
FEEDBACK_MAIL_TO=

# Continuous watching (see resources/watch/README.md)
WATCH_INTERVAL=15
WATCH_LLM_ENABLED=false
WATCH_LLM_URL=
WATCH_LLM_MODEL=qwen3:8b-q8_0
WATCH_LLM_LANGUAGE=Slovak
WATCH_LLM_LOGS=true

#Mobile apps
MOBILE_MIN_VERSION=1.1.0
ENABLE_REGISTER=true
